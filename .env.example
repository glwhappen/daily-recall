# 复制为 .env 后按需修改。全部留空也能跑（退化成纯本地模式）。

# ── 服务端 ──────────────────────────────────────────────
# 数据库密码（生产环境务必改掉）
POSTGRES_PASSWORD=change-me

# 站点公网地址：OIDC 回调地址靠它拼，必须与 provider 里登记的一模一样
PUBLIC_URL=https://memory.example.com

# 三个开关。设为 false 就退回纯本地模式，不必删掉数据库
AUTH_ENABLED=true
FEEDBACK_ENABLED=true
# 是否保留「邮箱 + 密码」注册（关掉则只走 OIDC）
AUTH_PASSWORD_ENABLED=true

# 管理员：邮箱白名单，或 OIDC 里的组名（逗号分隔）
ADMIN_EMAILS=you@example.com
ADMIN_GROUPS=

# ── 可选的 OIDC 单点登录 ─────────────────────────────────
# 留空则登录页不显示统一登录按钮。
# 任何标准 OIDC provider 都行：Authentik / Keycloak / Auth0 / Google ...
#   Authentik 的 issuer 形如 https://auth.example.com/application/o/<应用名>/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 登录按钮上的名字，默认取 issuer 的主机名
OIDC_NAME=
OIDC_SCOPES=openid profile email

# ── 端口（一般不用改）────────────────────────────────────
APP_PORT=4470
DB_PORT=4472
